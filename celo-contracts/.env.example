# Environment Variables for Celo Deployment

# Private key of deployer account (WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here

# Celoscan API Key for contract verification
CELOSCAN_API_KEY=your_celoscan_api_key

# RPC URLs (optional, defaults are set in hardhat.config.js)
ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org
CELO_RPC_URL=https://forno.celo.org

# Deployed Contract Addresses (will be filled after deployment)
EVENT_DISTRIBUTOR_ALFAJORES=
EVENT_DISTRIBUTOR_CELO=
