# Vault Distributor - Environment Configuration
# Copy this file to .env and fill in your values
# WARNING: Never commit .env with real credentials!

# ============================================
# NETWORK CONFIGURATION
# ============================================
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# For Mainnet (use with caution):
# STELLAR_NETWORK=mainnet
# STELLAR_RPC_URL=https://soroban-mainnet.stellar.org
# NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# ============================================
# CONTRACT CONFIGURATION
# ============================================
CONTRACT_ID=YOUR_CONTRACT_ID_HERE
CONTRACT_ALIAS=vault_distributor

# Admin Account (KEEP SECRET!)
ADMIN_KEY_NAME=admin
ADMIN_ADDRESS=G...YOUR_PUBLIC_KEY_HERE
# Note: Secret keys are stored in ~/.config/stellar/identity/

# ============================================
# VAULT INTEGRATION (RefiUp)
# ============================================
VAULT_CONTRACT_ID=CA3N53CPBLSVM5342DZ25LK47WFQDS6R3BT62327SGZCNJ54CDDXO7KZ
VAULT_MANAGER=GAUSHAKPQJEHLKT4FBUVMWXOX3HUVV5OXNFUY54OBWS2R7ZUQY6QUBR6

# ============================================
# TOKEN CONFIGURATION
# ============================================
XLM_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Add more token IDs as needed

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
SOURCE_ACCOUNT_NAME=admin
USE_FRIENDBOT=true
DEBUG=true
LOG_LEVEL=info

# ============================================
# EXPLORER URLS
# ============================================
EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
# For mainnet: https://stellar.expert/explorer/public
